# Local ports and browser-visible API URL
FRONTEND_PORT=3000
BACKEND_PORT=8000
NEXT_PUBLIC_API_BASE=http://localhost:8000

# SQLite (DATABASE_URL takes precedence when provided)
DATABASE_PATH=data/xuangu.db
# DATABASE_URL=sqlite:///data/xuangu.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# API and scheduler (Asia/Shanghai)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENABLE_SCHEDULER=true
QUOTE_SYNC_HOUR=15
QUOTE_SYNC_MINUTE=0
SELECTION_RUN_HOUR=15
SELECTION_RUN_MINUTE=30
# Set the same secret in the backend and GitHub Actions.
JOB_API_TOKEN=change-me
# Local domestic-machine uploader only.  Keep the production token in the
# untracked .env file; never place it in a command line or scheduled task.
SELECTION_IMPORT_URL=https://xuangu-production.up.railway.app/api/selections/import

# Optional market-data providers and rate limiting
# TUSHARE_TOKEN=
EASTMONEY_MIN_INTERVAL=1.0
# qfq daily K-line rotation. Tushare is skipped when TUSHARE_TOKEN is unset.
QUOTE_SOURCES=tencent,baidu,sina,tushare
QUOTE_SOURCE_FAILURE_THRESHOLD=3
QUOTE_SOURCE_COOLDOWN=300
# Bounded HTTP workers shared by the rotating quote providers.
TENCENT_SYNC_WORKERS=8
